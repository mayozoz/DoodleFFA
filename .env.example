# ── Client (Vite exposes only VITE_* vars to the browser; never put API keys here) ──
# Used for production builds; local dev uses the same-origin Vite WebSocket proxy.
VITE_STDB_URI=ws://localhost:3000
# Maincloud: VITE_STDB_URI=wss://maincloud.spacetimedb.com
VITE_STDB_DB=doodle-arena
# Production public base URL. In dev the QR code discovers the current LAN address.
VITE_PUBLIC_URL=http://localhost:5173

# ── Server secrets ──
# These are NOT read from env by the module. They live in the private `secrets` table.
# Load them with:  pnpm tsx scripts/set-secrets.ts   (reads the vars below and calls `set_secret`)
# ASI:One (Fetch.ai) — used by gen_spec when SPEC_PROVIDER = 'asi1' (server/src/config.ts)
ASI_ONE_API_KEY=
# Gemini image editing — converts each submitted doodle into a 2D weapon sprite
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=doodle-arena-assets
# Optional CloudFront domain that fronts the bucket (no trailing slash)
ASSET_BASE_URL=https://dxxxxxxxx.cloudfront.net
