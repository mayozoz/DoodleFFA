# Copy to .env (never commit it).
ASI_ONE_API_KEY=
# Any long random string. Fixes the agent's address across restarts.
AGENT_SEED=
# Shared with the game server (AGENT_SHARED_SECRET in the secrets table, Phase 2) so strangers
# can't spend your ASI:One credits through this endpoint.
AGENT_SHARED_SECRET=
AGENT_PORT=8001
# Public URL that SpacetimeDB (and Agentverse) can reach, e.g. an ngrok/Fly/Render URL.
AGENT_PUBLIC_URL=http://localhost:8001
